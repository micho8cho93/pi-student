{
  "name": "pi-student",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "description": "A terminal-first educational coding agent built on Pi.",
  "engines": {
    "node": ">=23.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "bin": {
    "pi": "apps/client/dist/cli.js",
    "pi-student": "apps/client/dist/cli.js",
    "pi-student-runtime": "apps/client/dist/runtime-cli.js",
    "learn-agent": "apps/client/dist/cli.js"
  },
  "scripts": {
    "build": "turbo run build",
    "build:client": "turbo run build --filter=@pi-student/client",
    "build:teacher": "turbo run build --filter=@pi-student/teacher-console",
    "build:org-admin": "turbo run build --filter=@pi-student/org-admin",
    "build:platform-admin": "turbo run build --filter=@pi-student/platform-admin",
    "start:org-admin": "npm run start --workspace=@pi-student/org-admin",
    "start:platform-admin": "npm run start --workspace=@pi-student/platform-admin",
    "dev": "npm run build && PI_STUDENT_DEV=1 tsx apps/client/src/cli.ts",
    "start": "node scripts/start-dev.mjs",
    "test": "npm run test:architecture && turbo run test",
    "test:architecture": "node --test tooling/architecture.test.mjs",
    "test:client": "turbo run test --filter=@pi-student/client",
    "test:teacher": "turbo run test --filter=@pi-student/teacher-console",
    "test:org-admin": "turbo run test --filter=@pi-student/org-admin",
    "test:platform-admin": "turbo run test --filter=@pi-student/platform-admin",
    "check:boundaries": "node tooling/check-boundaries.mjs",
    "check:versions": "node tooling/check-versions.mjs",
    "ci:affected": "turbo run build typecheck test --affected",
    "package:client": "./scripts/package-release.sh",
    "package:teacher": "./scripts/package-teacher-console.sh",
    "infra:start": "supabase start --workdir infra",
    "infra:reset": "supabase db reset --local --workdir infra",
    "infra:lint": "supabase db lint --local --fail-on error --workdir infra",
    "infra:test": "supabase test db --local --workdir infra",
    "test:watch": "vitest",
    "test:sandbox": "npm run build && node packages/sandbox-gondolin/dist/smoke.js",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@getpaseo/cli": "^0.8.0",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "supabase": "2.117.0",
    "tsx": "^4.19.2",
    "turbo": "^2.10.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
